{
  "project": {
    "name": "Psalmody Press Artists",
    "version": "1.0.0"
  },
  "paths": {
    "psalms_input": "data/input/psalms",
    "artists_input": "data/input/artists",
    "output_base": "data/output",
    "prompt_database": "data/prompts.db"
  },
  "sequence_tracking": {
    "enabled": true,
    "base": 36,
    "sequence_length": 5,
    "embed_in_titles": true,
    "title_format": "{title} [{sequence_id}]"
  },
  "generation": {
    "provider": "anthropic",
    "ai_model": "claude-sonnet-4-20250514",
    "temperature": 0.7,
    "max_tokens": 2000
  },
  "psalm_naming": {
    "format": "psalm_{number:03d}.txt",
    "total_psalms": 150
  },
  "output_files": {
    "suno_lyrics": "suno_lyrics.txt",
    "suno_prompt": "suno_prompt.txt",
    "midjourney_prompt": "midjourney_prompt.txt",
    "typography_prompt": "typography_prompt.txt",
    "youtube_channel": "youtube_channel.json",
    "youtube_video": "youtube_video.json"
  },
  "asset_naming": {
    "suno_song": "psalm_{psalm:03d}_{sequence_id}_song",
    "midjourney_image": "psalm_{psalm:03d}_{sequence_id}_cover",
    "typography_image": "psalm_{psalm:03d}_{sequence_id}_typography"
  }
}
